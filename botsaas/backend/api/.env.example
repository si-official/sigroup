# =============================================================================
# AI Chat-Commerce SaaS — environment
# Copy to .env and fill in. NEVER commit .env.
# Keys marked [REQUIRED] abort boot if missing (Core\Env::require).
# =============================================================================

# ---------- APP ----------
APP_NAME="Chat Commerce"
APP_ENV=local                      # local | staging | production
APP_DEBUG=true                     # MUST be false in production
APP_URL=http://localhost:8080      # [REQUIRED] API base, no trailing slash
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
PANEL_URL=http://localhost:3000    # tenant panel origin (CORS + redirects)
ADMIN_URL=http://localhost:3001    # admin panel origin
WIDGET_URL=http://localhost:8080   # where widget.js is served from
TRUSTED_PROXIES=                   # CSV of proxy IPs; enables X-Forwarded-For

# ---------- DATABASE ----------
DB_HOST=127.0.0.1                  # [REQUIRED] 127.0.0.1 on Hostinger, never the srvNNNN host
DB_PORT=3306
DB_DATABASE=chatcommerce           # [REQUIRED]
DB_USERNAME=root                   # [REQUIRED]
DB_PASSWORD=                       # [REQUIRED] in production
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEOUT=5

# ---------- JWT ----------
JWT_SECRET=                        # [REQUIRED] 64+ random chars: openssl rand -base64 48
JWT_ALGO=HS256                     # pinned; 'none' and RS/HS confusion are rejected
JWT_ACCESS_TTL=900                 # 15 min
JWT_REFRESH_TTL=2592000            # 30 days
JWT_ISSUER=chatcommerce
JWT_LEEWAY=10                      # clock-skew seconds

# ---------- CRYPTO (at-rest encryption of third-party tokens) ----------
# 32 raw bytes, base64: openssl rand -base64 32
CRYPTO_KEY=                        # [REQUIRED]
CRYPTO_KEY_PREVIOUS=               # set during key rotation, then re-encrypt, then clear

# ---------- MIGRATIONS ----------
MIGRATE_SECRET=                    # [REQUIRED] guards POST /api/_migrate on shared hosting

# ---------- RATE LIMITS (requests per window) ----------
RATE_LIMIT_IP=300                  # per IP per minute
RATE_LIMIT_USER=600                # per authenticated user per minute
RATE_LIMIT_TENANT=1200             # per tenant per minute
RATE_LIMIT_AUTH=5                  # login attempts per email per 15 min
RATE_LIMIT_WINDOW=60

# ---------- QUEUE / CRON ----------
WORKER_MAX_SECONDS=50              # hard ceiling: shared hosting kills long processes
WORKER_BATCH_SIZE=20
WORKER_ID=                         # leave blank to auto-generate per run
CRON_HEARTBEAT_ALERT_MINUTES=5

# ---------- META / FACEBOOK + INSTAGRAM ----------
META_APP_ID=
META_APP_SECRET=                   # used for X-Hub-Signature-256 verification
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=                 # your side of the webhook handshake
META_REDIRECT_URI=                 # OAuth callback for one-click page connect

# ---------- WHATSAPP CLOUD API ----------
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---------- AI PROVIDERS (platform keys; tenants may add their own in DB) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_API_KEY=
AI_REQUEST_TIMEOUT=45
AI_MAX_TOOL_ROUNDS=5
AI_PROMPT_TOKEN_CEILING=12000
AI_COST_MARKUP=1.6                 # credit-mode multiplier on provider cost

# ---------- SPEECH ----------
STT_PROVIDER=openai
TTS_PROVIDER=openai
VOICE_MAX_DURATION_SEC=300
VOICE_MAX_BYTES=10485760

# ---------- PAYMENT GATEWAYS ----------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
MANUAL_PAYMENT_NUMBERS=            # e.g. "bKash:01XXXXXXXXX,Nagad:01XXXXXXXXX"

# ---------- COURIERS ----------
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_SANDBOX_BASE_URL=https://courier-api-sandbox.pathao.com
COURIER_SYNC_BATCH=100

# ---------- MAIL ----------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Chat Commerce"

# ---------- STORAGE ----------
STORAGE_DISK=local                 # local | s3 | r2
STORAGE_LOCAL_PATH=storage/uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
S3_KEY=
S3_SECRET=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
UPLOAD_MAX_BYTES=5242880
UPLOAD_IMAGE_MAX_DIMENSION=1600

# ---------- LOGGING ----------
LOG_LEVEL=debug                    # debug|info|warning|error|critical
LOG_PATH=storage/logs
LOG_RETENTION_DAYS=14

# ---------- RETENTION (days; used by the cleanup cron) ----------
RETAIN_WEBHOOK_EVENTS=14
RETAIN_DONE_JOBS=7
RETAIN_ACTIVITY_LOGS=90
RETAIN_AI_REQUESTS=180
RETAIN_MESSAGES=365
